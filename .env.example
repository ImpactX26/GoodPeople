# --- LLM (pick one) ------------------------------------------------------
# Claude (default provider)
ANTHROPIC_API_KEY=
LUNA_LLM_PROVIDER=anthropic
# LUNA_LLM_MODEL=claude-sonnet-4-5

# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Gemini OpenAI-compat, Ollama...)
# LUNA_LLM_PROVIDER=openai
# LUNA_LLM_API_KEY=
# LUNA_LLM_MODEL=gpt-4o-mini
# LUNA_LLM_BASE_URL=https://api.openai.com/v1

# --- Food safety check (photo + Food Agent) -------------------------------
# Uses Google Gemini, separate from the provider above. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional backup key (another Google account), used when the first hits its rate limit.
GEMINI_API_KEY_2=
LUNA_FOOD_LLM_PROVIDER=gemini
# LUNA_FOOD_LLM_MODEL=gemini-3.5-flash

# --- Behaviour -----------------------------------------------------------
# Allow the transparent rule-based fallback when the LLM is missing/fails (true/false)
LUNA_ALLOW_RULE_FALLBACK=true
# Where finished Match Results are POSTed (Luna Orchestrator), optional
# LUNA_ORCHESTRATOR_WEBHOOK=http://localhost:9000/api/orchestrator/match-result
# LUNA_DATA_DIR=./data

# Free backup for every model call: the food photo check if Gemini fails, and the agents' reasoning
# (https://console.groq.com, no card needed). The API reads this file too (npm run dev, start-luna.sh --local).
GROQ_API_KEY=
