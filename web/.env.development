# Shared dev settings (committed). Everyone's local frontend talks to the live Railway backend.
# To use a local API instead, put NEXT_PUBLIC_API_URL=http://localhost:8787 in .env.development.local (not committed).
NEXT_PUBLIC_API_URL=https://api-production-a32be.up.railway.app

# NGO Matching Agent (Python, repo root: `python run.py`). Powers /ngo/list, /ngo/agent and /ngo/offers.
NEXT_PUBLIC_NGO_API_URL=http://localhost:8000
