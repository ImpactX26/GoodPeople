# Luna API base URL. Local dev uses the Railway backend; set a local API (http://localhost:8787) to work offline.
NEXT_PUBLIC_API_URL=https://api-production-a32be.up.railway.app

# NGO Matching Agent (Python FastAPI, `python run.py` at the repo root)
NEXT_PUBLIC_NGO_API_URL=http://localhost:8000

# Enable Maps JavaScript API. Restrict this browser key to your app's HTTPS domains
# and localhost development origins. This is separate from the server Routes key.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
