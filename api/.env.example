# Railway sets PORT and DATABASE_URL. Without DATABASE_URL the API keeps data in memory.
PORT=8787
DATABASE_URL=
# Fixed dev code; no SMS is sent.
DEV_OTP=123456
# 1 = return the dev code to the client so the sign-in screen can show it.
SHOW_DEV_OTP=1
# Comma-separated browser origins allowed to call the API (localhost is always allowed).
CORS_ORIGINS=

# In-app delivery navigation. Enable Routes API on a billing-enabled Google Cloud project.
# Restrict this server key to Routes API and your server egress IP when available.
GOOGLE_MAPS_ROUTES_KEY=
# Stable random secret for encrypting handover codes at rest. Required with DATABASE_URL.
TRIP_CODE_SECRET=
# Shared server-to-server key for the Logistics Agent's delivery handoff.
LOGISTICS_HANDOFF_KEY=
# Sample delivery controls are enabled by default only for the local memory store.
ENABLE_TRIP_DEMO=0
# Smart Matching Agent: WhatsApp (Meta Cloud API, free test number).
# Without the phone number ID and token, messages are printed to the console instead of sent.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Any string you choose; enter the same one as the webhook's verify token in Meta's dashboard.
WHATSAPP_VERIFY_TOKEN=
# Optional: when set, incoming webhook calls must carry Meta's signature.
WHATSAPP_APP_SECRET=
# 1 = send approved templates (luna_food_offer, ...). Until they're approved, leave at 0:
# plain messages work once a phone has messaged the test number in the last 24 hours.
WHATSAPP_TEMPLATES=0
# Sample NGOs and partners answer on their own only with MATCHING_SIMULATE=1 (default: on for the local
# memory store, off with DATABASE_URL, so real food never goes to a sample NGO).
MATCHING_SIMULATE=
# 0 = skip the admin check on a new donor's first listing.
MATCHING_REVIEW_FIRST=1
