{
  "name": "luna-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\" \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@types/node": "^26.6.3",
    "hono": "^4.13.12",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2"
  }
}
